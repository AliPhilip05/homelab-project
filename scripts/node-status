#!/usr/bin/env bash
set -u
printf '=== NODE STATUS (%s) ===\n\n' "$(hostname)"
printf '%s\n' 'CPU / UPTIME'
uptime
printf '\nMEMORY / SWAP\n'
free -h
printf '\nROOT DISK\n'
df -h /
printf '\nTEMPERATURE\n'
if command -v vcgencmd >/dev/null 2>&1; then
    vcgencmd measure_temp
elif [ -r /sys/class/thermal/thermal_zone0/temp ]; then
    awk '{printf "%.1f C\n", $1/1000}' /sys/class/thermal/thermal_zone0/temp
elif command -v sensors >/dev/null 2>&1; then
    sensors | head -20
else
    echo 'No supported sensor found'
fi
printf '\nSERVICES\n'
for service in ssh docker tailscaled; do
    printf '%-12s %s\n' "$service" "$(systemctl is-active "$service" 2>/dev/null || echo unavailable)"
done
printf '\nCONTAINERS\n'
if command -v docker >/dev/null 2>&1; then
    docker ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null || echo 'Docker access restricted; use sudo docker ps'
else
    echo 'Docker not installed'
fi
