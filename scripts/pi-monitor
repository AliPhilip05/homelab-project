#!/usr/bin/env bash
set -e
SESSION=pi-monitor
if [ -n "${TMUX:-}" ]; then
  echo 'Detach from the current tmux session before launching.'
  exit 1
fi
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  exec tmux attach-session -t "=$SESSION"
fi
tmux new-session -d -s "$SESSION" -n dashboard
tmux send-keys -t "$SESSION:dashboard.0" 'btop' Enter
tmux split-window -h -t "$SESSION:dashboard.0" 'watch -n 3 ~/.local/bin/pi-status'
tmux split-window -v -t "$SESSION:dashboard.1" 'watch -n 5 ~/.local/bin/docker-status'
tmux select-pane -t "$SESSION:dashboard.0"
exec tmux attach-session -t "=$SESSION"
